{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Copilot Token Cost",
  "version": "0.1.0",
  "identifier": "com.ekroon.copilot-token-cost",
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/copilot-token-cost"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ekroon/copilot-token-cost/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMkQ5RDMxMzlENDFFNDEKUldSQkh0UTVNWjB0WWliRG9MbktUNEk0d3pEU2VZV1d4OUJ0OUZkRnZqTGtHc1hFVy9lZEdITk4K"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Copilot Token Cost",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7332; script-src 'self' 'unsafe-inline' http://127.0.0.1:7332 https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' http://127.0.0.1:7332; connect-src 'self' http://127.0.0.1:7332; img-src 'self' http://127.0.0.1:7332 data:; font-src 'self' http://127.0.0.1:7332"
    }
  }
}
